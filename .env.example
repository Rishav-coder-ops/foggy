# ==========================================
# Foggy Client Build-Time Configuration
# ==========================================
# The VITE_FIREBASE_* values are public web configuration needed by the frontend at build time.
# Add these under Environment Variables (Build Variables) in the Cloudflare Pages dashboard.
# Never prefix secret API keys with VITE_.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ==========================================
# Cloudflare Pages Functions Secrets (Server-Side)
# ==========================================
# In Cloudflare Pages, add these as encrypted Secrets under Settings > Environment Variables:
# - GEMINI_API_KEY (Google AI Studio)
# - AQI_API_KEY    (World Air Quality Index Token)
#
# For local development with "wrangler pages dev dist", place them in .dev.vars (see .dev.vars.example).
