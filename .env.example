# ==========================================
# Foggy Environment Configuration
# ==========================================

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# World Air Quality Index (WAQI) Token
# Request your free token at: https://aqicn.org/data-platform/token/
AQI_API_KEY=your_waqi_token_here

# Backend Proxy Server Port
PORT=3001
