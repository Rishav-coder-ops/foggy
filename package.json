{
  "name": "foggy-air-quality-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Foggy - A GenAI-powered assistant helping families and communities navigate severe winter smog and urban air pollution with personalized, practical guidance.",
  "author": {
    "name": "Rishav Nandi",
    "url": "https://github.com/Rishav-coder-ops",
    "github": "https://github.com/Rishav-coder-ops",
    "linkedin": "https://www.linkedin.com/in/rishav-nandi-2k7/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rishav-coder-ops/foggy.git"
  },
  "homepage": "https://github.com/Rishav-coder-ops/foggy#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "lint": "eslint src functions server tests shared",
    "lint:fix": "eslint --fix src functions server tests shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vitest": "vitest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci:local": "node scripts/ci-local.js",
    "build": "pnpm run lint && vite build",
    "pages:dev": "wrangler pages dev dist",
    "preview": "wrangler pages dev dist",
    "server": "node server/index.js",
    "client": "vite",
    "start": "wrangler pages dev dist",
    "prepare": "husky"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase": "^13.4.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.163.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
