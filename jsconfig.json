{
  "compilerOptions": {
    "checkJs": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "shared/**/*",
    "src/utils/**/*",
    "src/services/**/*",
    "server/**/*",
    "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
